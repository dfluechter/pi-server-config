#!/usr/bin/env bash
set -euo pipefail

# Prüft alle im Git-Index vorgemerkten (staged) Dateien auf unzensierte Secrets
python3 - << 'PYEOF'
import re
import subprocess
import sys

# 1. Verbotene Dateinamen (dürfen niemals im Repository landen)
FORBIDDEN_FILES = re.compile(
    r"(^|/)\.secrets$|(^|/)\.env(\..+)?$|\.(pem|key|p12|pfx)$|(^|/)id_(rsa|ed25519|ecdsa)$",
    re.IGNORECASE,
)

# 2. Bekannte API-Key-Formate (z. B. Google/Gemini, Groq, OpenAI, GitHub)
KNOWN_TOKEN_PATTERNS = [
    ("Google/Gemini API-Key", re.compile(r"\bAIza[0-9A-Za-z_-]{30,}\b")),
    ("Google/GCP Token", re.compile(r"\bAQ\.[0-9A-Za-z_-]{30,}\b")),
    ("Groq API-Key", re.compile(r"\bgsk_[0-9A-Za-z]{20,}\b")),
    ("OpenAI/Anthropic Key", re.compile(r"\bsk-[0-9A-Za-z_-]{20,}\b")),
    ("GitHub Token", re.compile(r"\b(ghp_[0-9A-Za-z]{20,}|github_pat_[0-9A-Za-z_]{20,})\b")),
]

# 3. Verdächtige Zuweisungen in Konfigurationsdateien (KEY=..., password=..., token: ...)
ASSIGNMENT_PATTERN = re.compile(
    r"(?:^|[,\s;])(?:export\s+)?([A-Za-z0-9_.-]*(?:KEY|TOKEN|SECRET|PASSWORD|PASS|PWD)[A-Za-z0-9_.-]*)\s*[:=]\s*[\"']?([^\"'\s,;\#]+)[\"']?",
    re.IGNORECASE,
)

# Werte, die als harmlos oder bereits maskiert gelten
SAFE_PLACEHOLDERS = re.compile(
    r"^(\*+|x+|\[.*\]|<.*>|DEIN_.*|YOUR_.*|CHANGEME|TODO|NONE|NULL|TRUE|FALSE|0|1|[\[\(\$\{\\].*)$",
    re.IGNORECASE,
)

staged_raw = subprocess.check_output(
    ["git", "diff", "--cached", "--diff-filter=ACM", "-z", "--name-only"]
)
staged_files = [p.decode("utf-8", errors="replace") for p in staged_raw.split(b"\x00") if p]

violations = []

for rel_path in staged_files:
    if FORBIDDEN_FILES.search(rel_path):
        violations.append((rel_path, 0, "Verbotene Geheimnis- oder Schlüsseldatei"))
        continue

    try:
        blob = subprocess.check_output(["git", "show", f":{rel_path}"])
    except subprocess.CalledProcessError:
        continue

    if b"\x00" in blob:
        continue  # Binärdateien überspringen

    text = blob.decode("utf-8", errors="replace")
    for line_no, line in enumerate(text.splitlines(), start=1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        for label, token_re in KNOWN_TOKEN_PATTERNS:
            if token_re.search(line):
                violations.append((rel_path, line_no, f"{label} erkannt"))

        for match in ASSIGNMENT_PATTERN.finditer(line):
            var_name, val = match.group(1), match.group(2)
            if len(val) >= 6 and not SAFE_PLACEHOLDERS.match(val):
                violations.append(
                    (rel_path, line_no, f"Unmaskierter Wert für '{var_name}'")
                )

if violations:
    print("\n\033[0;31m[BLOCKIERT] Git Pre-Commit-Hook hat mögliche Secrets gefunden:\033[0m\n")
    for path, line_no, reason in violations:
        loc = f"{path}:{line_no}" if line_no else path
        print(f"  - {loc} -> {reason}")
    print(
        "\nBitte maskiere die betroffenen Werte (z. B. über git-sync-configs.sh) "
        "oder entferne die Datei mit 'git reset HEAD <datei>' aus dem Staging.\n"
    )
    sys.exit(1)

sys.exit(0)
PYEOF
