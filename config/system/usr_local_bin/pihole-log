#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Farbiges Pi-hole v6 & Unbound Log-Analyse-Tool
# Pfad: /usr/local/bin/pihole-log
# Aufruf:
#   pihole-log                 -> Live-Stream aller DNS-Anfragen (farbig)
#   pihole-log 192.168.2.118   -> Live-Stream gefiltert auf eine IP / ein Gerät
#   pihole-log stats           -> Top-Clients, Top-Blocks, Rate-Limits & Unbound-Status
# ==============================================================================

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BLUE='\033[0;34m'
NC='\033[0m'

QUERY_LOG="/var/log/pihole/pihole.log"
FTL_LOG="/var/log/pihole/FTL.log"

show_stats() {
    echo -e "${BLUE}=====================================================================${NC}"
    echo -e "${CYAN} 📊 PI-HOLE v6 & UNBOUND LOG-AUSWERTUNG ($(date +'%H:%M:%S'))${NC}"
    echo -e "${BLUE}=====================================================================${NC}"

    echo -e "\n${MAGENTA}1. Top 10 aktivste Clients im heutigen Log:${NC}"
    sudo awk '/query\[/ {print $NF}' "$QUERY_LOG" 2>/dev/null | sort | uniq -c | sort -nr | head -n 10 | \
        awk -v c="$CYAN" -v g="$GREEN" -v n="$NC" '{printf "   %s%-8s%s Anfragen von IP: %s%s%s\n", g, $1, n, c, $2, n}'

    echo -e "\n${RED}2. Top 10 geblockte Domains heute:${NC}"
    sudo awk '/gravity blocked|exact blacklisted|regex blacklisted/ {print $(NF-2)}' "$QUERY_LOG" 2>/dev/null | sort | uniq -c | sort -nr | head -n 10 | \
        awk -v r="$RED" -v y="$YELLOW" -v n="$NC" '{printf "   %s%-8s%s Blockiert: %s%s%s\n", y, $1, n, r, $2, n}'

    echo -e "\n${YELLOW}3. Rate-Limit & Warnmeldungen in FTL.log:${NC}"
    if sudo grep -iE "rate-limit|WARNING|ERROR" "$FTL_LOG" 2>/dev/null | tail -n 10; then
        true
    else
        echo -e "   ${GREEN}Keine aktuellen Rate-Limits oder Warnungen gefunden.${NC}"
    fi

    echo -e "\n${GREEN}4. Unbound DNS-Server Direkt-Test (127.0.0.1#5335):${NC}"
    unbound_time=$(dig @127.0.0.1 -p 5335 cloudflare.com | awk '/Query time:/ {print $4 " " $5}')
    echo -e "   Antwortzeit Unbound: ${GREEN}${unbound_time:-Fehler}${NC}"
    echo -e "${BLUE}=====================================================================${NC}"
}

stream_colored_log() {
    local filter="${1:-}"
    echo -e "${BLUE}=====================================================================${NC}"
    echo -e "${CYAN} 🔍 LIVE DNS-LOG STREAM (Beenden mit STRG+C)${NC}"
    [[ -n "$filter" ]] && echo -e "${YELLOW} 🎯 Aktivierter Filter: '${filter}'${NC}"
    echo -e " Legende: ${RED}[BLOCKED]${NC} | ${GREEN}[CACHED]${NC} | ${YELLOW}[UNBOUND]${NC} | ${CYAN}[QUERY]${NC}"
    echo -e "${BLUE}=====================================================================${NC}"

    sudo tail -f "$QUERY_LOG" | grep --line-buffered -i "$filter" | awk \
        -v r="$RED" -v g="$GREEN" -v y="$YELLOW" -v c="$CYAN" -v m="$MAGENTA" -v n="$NC" '
        /gravity blocked|blacklisted|blocked/ {
            print r "[BLOCKED]  " $0 n; next
        }
        /cached|local|pi\.hole/ {
            print g "[CACHED]   " $0 n; next
        }
        /forwarded/ {
            print y "[UNBOUND]  " $0 n; next
        }
        /query\[/ {
            print c "[QUERY]    " $0 n; next
        }
        /reply/ {
            print m "[REPLY]    " $0 n; next
        }
        { print $0 }
    '
}

case "${1:-}" in
    stats|--stats|-s)
        show_stats
        ;;
    *)
        stream_colored_log "${1:-}"
        ;;
esac
